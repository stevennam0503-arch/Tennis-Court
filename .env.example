POSTGRES_DB=courtly
POSTGRES_USER=courtly
POSTGRES_PASSWORD=courtly_local

# Secure defaults: demo features and sample fixtures disabled by default
# Set SEED_DEMO=true for initial local setup with demo courts, staff, and tournaments
SEED_DEMO=false

# Set DEMO_MODE=true for local testing to get OTP devCode in API response
DEMO_MODE=false

ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=

# Set to true in production over HTTPS/SSL to enforce secure session cookies
COOKIE_SECURE=false

# Local testing only; use LIVE with bank details and webhook key for real transfers.
PAYMENT_MODE=SANDBOX
PAYMENT_BANK_BIN=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
SEPAY_WEBHOOK_KEY=
