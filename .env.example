POSTGRES_DB=courtly
POSTGRES_USER=courtly
POSTGRES_PASSWORD=courtly_local

# Secure defaults: demo features and sample fixtures disabled by default
# Set SEED_DEMO=true for initial local setup with demo courts, staff, and tournaments
SEED_DEMO=false

# Set DEMO_MODE=true for local testing to get OTP devCode in API response
DEMO_MODE=false

ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=

# Set to true in production over HTTPS/SSL to enforce secure session cookies
COOKIE_SECURE=false

# Use DEMO_MODE=true and PAYMENT_MODE=SANDBOX together only on an isolated demo database.
# Use LIVE (or SEPAY) with real bank details and webhook key for real transfers.
PAYMENT_MODE=MANUAL
PAYMENT_BANK_BIN=970422
PAYMENT_ACCOUNT_NUMBER=0345678999
PAYMENT_ACCOUNT_NAME=CLB TENNIS COURTLY
SEPAY_WEBHOOK_KEY=

# Gmail SMTP Configuration (Cấu hình gửi email thông báo, kích hoạt và OTP)
# LƯU Ý CHO LẬP TRÌNH VIÊN:
# - Để gửi email thật qua Gmail SMTP, bật xác minh 2 bước rồi tạo Mật khẩu ứng dụng (App Password 16 ký tự).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=kietdlv@gmail.com
SMTP_PASSWORD=
SMTP_FROM=kietdlv@gmail.com
SMTP_FROM_NAME=Courtly Tennis Club

# Chế độ thông báo (NOTIFY_MODE):
# - LOG: Không gửi ra ngoài, chỉ ghi log và lưu lịch sử thông báo (an toàn khi demo)
# - LIVE: Gửi email SMTP thật và/hoặc SMS thật
# NOTIFY_ALLOWLIST: Danh sách email và SĐT được phép nhận tin khi chạy LIVE (phân tách bởi dấu phẩy).
# Nếu để trống allowlist trong môi trường thật, hệ thống sẽ gửi cho mọi khách hàng.
NOTIFY_MODE=LOG
NOTIFY_ALLOWLIST=kietdlv@gmail.com,phuongmaiphanqn3@gmail.com,+84769496289,+84377035664,0769496289,0377035664
